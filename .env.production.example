# Copy to .env.production on the server and run: chmod 600 .env.production
# Use a bare hostname here. DNS A/AAAA records must already point to the server.
SITE_ADDRESS=storyloom.example.com

# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-value

# Encrypts visitors' short-lived BYOK sessions. This is not a login password.
# Generate independently with: openssl rand -hex 32
MODEL_ACCESS_SECRET=replace-with-another-random-64-character-hex-value
MODEL_ACCESS_SESSION_HOURS=24

IMAGE_TAG=local

# Optional Docker Hub prefix. Mainland China example:
# DOCKER_HUB_PREFIX=m.daocloud.io/docker.io/library/
DOCKER_HUB_PREFIX=

# Trusted reverse-proxy range. Only this network may set X-Forwarded-For; keep it aligned with
# the compose network subnet so a visitor cannot forge a fresh client address to reset rate limits.
STORYLOOM_TRUSTED_PROXY=172.28.0.0/16
STORYLOOM_NETWORK_SUBNET=172.28.0.0/16

# Zhihu account login. App ID and App Key come from the hackathon project page; register the same
# redirect URI on the Zhihu open platform. The App Key is a server secret: keep it only here as a
# deployment secret, never in the repository, an image layer or a log line.
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
# Must be the public HTTPS callback, exactly as registered: https://<SITE_ADDRESS>/auth/callback
ZHIHU_OAUTH_REDIRECT_URI=

# Compute beans for signed-in accounts: a one-time grant per account, spent instead of the shared
# pool. The default 500 covers roughly one six-shot film (6 clips x 48 + ~18 images x 5 + text).
# Set BEANS_INITIAL_GRANT=0 to make accounts pay with their own keys from the start.
BEANS_INITIAL_GRANT=500
BEANS_LLM_COST=1
BEANS_IMAGE_COST=5
BEANS_VIDEO_COST_PER_SECOND=6

# Lightweight safeguards sized for the documented 2 vCPU / 2 GiB demo host.
# Health checks are exempt. Reads and writes use separate per-IP minute buckets.
PUBLIC_READ_REQUESTS_PER_MINUTE=180
PUBLIC_WRITE_REQUESTS_PER_MINUTE=20
PUBLIC_MAX_ACTIVE_TASKS=32

# Operator credentials. These are spent by signed-in accounts through their bean wallets, and are
# never handed to a browser. Providers, endpoints, and models are fixed to DeepSeek Flash,
# SiliconFlow Z-Image, and MiniMax H3 Max; visitors cannot select replacements. The operator may
# select another DeepSeek model here.
LLM_MODEL=deepseek-flash
LLM_FAST_MODEL=deepseek-flash
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
