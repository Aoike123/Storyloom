# Copy to .env.production on the server and run: chmod 600 .env.production
# Use a bare hostname here. DNS A/AAAA records must already point to the server.
SITE_ADDRESS=storyloom.example.com

# Generate a URL-safe value with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-64-character-hex-value

# Encrypts visitors' short-lived BYOK sessions. This is not a login password.
# Generate independently with: openssl rand -hex 32
MODEL_ACCESS_SECRET=replace-with-another-random-64-character-hex-value
MODEL_ACCESS_SESSION_HOURS=24

IMAGE_TAG=local

# Optional Docker Hub prefix. Mainland China example:
# DOCKER_HUB_PREFIX=m.daocloud.io/docker.io/library/
DOCKER_HUB_PREFIX=

# Public pool: a conservative internal reservation budget that resets at
# midnight Asia/Shanghai. Set ENABLED=false to offer BYOK only.
PUBLIC_POOL_ENABLED=true
PUBLIC_POOL_LLM_DAILY_BUDGET_CNY=30.00
PUBLIC_POOL_IMAGE_DAILY_BUDGET_CNY=30.00
PUBLIC_POOL_VIDEO_DAILY_BUDGET_CNY=30.00
PUBLIC_POOL_LLM_RESERVE_CNY=0.20
PUBLIC_POOL_IMAGE_RESERVE_CNY=0.50
PUBLIC_POOL_VIDEO_RESERVE_CNY=6.00
PUBLIC_POOL_VERIFY_DEEPSEEK_BALANCE=true
PUBLIC_POOL_MIN_DEEPSEEK_CNY=0.05

# Operator-funded pool credentials. Providers, endpoints, and models are fixed
# to DeepSeek V4 Flash, SiliconFlow Z-Image, and MiniMax H3 Max; visitors cannot
# select replacements.
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
