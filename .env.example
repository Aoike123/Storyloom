# Copy to .env.local. Keep secrets on this computer, never paste them in chat.
DATABASE_URL=sqlite:///./data/story.db
# PostgreSQL alternative: postgresql+psycopg://story:story@127.0.0.1:5432/story
DATA_DIR=./data

# Two network-bound lanes let short reader-branch clips submit and ingest concurrently.
READER_BRANCH_WORKERS=2

# Normal local use enters BYOK credentials on /setup. Storyloom fixes the
# providers and models to DeepSeek V4 Pro, SiliconFlow Z-Image, and MiniMax H3 Max.
# The operator may set LLM_MODEL/LLM_FAST_MODEL to another DeepSeek model.
# The local encryption secret is generated automatically below DATA_DIR.
LLM_MODEL=deepseek-flash
LLM_FAST_MODEL=deepseek-flash

# The operator's keys are spent only through a signed-in account's bean wallet. There is no
# anonymous pool, so a browser must sign in or attach its own keys before anything is generated.
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=
