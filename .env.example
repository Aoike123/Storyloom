# Copy to .env.local. Keep secrets on this computer, never paste them in chat.
DATABASE_URL=sqlite:///./data/story.db
# PostgreSQL alternative: postgresql+psycopg://story:story@127.0.0.1:5432/story
DATA_DIR=./data
# Full chat-completions endpoint for your provider, not just a base URL.
LLM_PROVIDER=deepseek
LLM_ENDPOINT=https://api.deepseek.com/chat/completions
LLM_MODEL=
LLM_API_KEY=
# MiniMax H3 Max official V2 API. Existing Ark configs remain supported with VIDEO_PROVIDER=ark.
VIDEO_PROVIDER=minimax
VIDEO_ENDPOINT=https://api.minimax.io/v2/video_generation
VIDEO_MODEL=MiniMax-H3-Max
VIDEO_DURATION=8
VIDEO_RESOLUTION=768P
VIDEO_API_KEY=
# SiliconFlow hosted Z-Image. Use a matching regional account/key.
IMAGE_PROVIDER=siliconflow
IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
IMAGE_ENDPOINT=https://api.siliconflow.cn/v1/images/generations
IMAGE_API_KEY=
# Off by default. Enable only after deciding your paid test allowance.
ALLOW_PAID_CALLS=false
