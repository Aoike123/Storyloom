# Storyloom local workbench configuration.
# Copy this file to .env.local and fill in your own model keys.
# Keep the secrets on this machine only — never paste them into chat or commit them to git.

# Database: local SQLite by default. To use a local Postgres instead, start it with compose.yaml
#   (docker compose up -d db) and set:
#   DATABASE_URL=postgresql+psycopg://story:story@127.0.0.1:5432/story
DATABASE_URL=sqlite:///./data/story.db
DATA_DIR=./data

# Two network-bound lanes let short reader-branch clips submit and ingest concurrently.
READER_BRANCH_WORKERS=2

# Your own model keys. Everything is local: the workbench only generates when the keys it needs
# are set here. Endpoints and model names have working defaults, so only the API keys are required.
#   LLM   — DeepSeek (text, storyboarding)
#   IMAGE — SiliconFlow (still frames)
#   VIDEO — MiniMax (clips)
LLM_API_KEY=
IMAGE_API_KEY=
VIDEO_API_KEY=

# Optional overrides. The defaults below work out of the box; change the model names to any
# compatible model you have access to.
LLM_MODEL=deepseek-flash
LLM_FAST_MODEL=deepseek-flash
