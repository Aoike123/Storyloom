{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structure Screenplay Result",
  "allOf": [
    {
      "$ref": "../../../schemas/common/result-envelope.schema.json"
    }
  ],
  "properties": {
    "skill": {
      "const": "structure-screenplay"
    },
    "data": {
      "type": "object",
      "required": ["scenes", "units", "beats", "rhythm_curve", "progress"],
      "properties": {
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceableItem"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceableItem"
          }
        },
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/traceableItem"
          }
        },
        "rhythm_curve": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["beat_id", "intensity"],
            "properties": {
              "beat_id": {
                "type": "string"
              },
              "intensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          }
        },
        "progress": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "traceableItem": {
      "type": "object",
      "required": ["id", "source_refs"],
      "properties": {
        "id": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "unevaluatedProperties": false
}
