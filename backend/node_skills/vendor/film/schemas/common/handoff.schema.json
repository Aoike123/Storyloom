{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Handoff",
  "type": "object",
  "required": ["artifacts", "ready_for", "blocked_by"],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "schema": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ready_for": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "blocked_by": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
