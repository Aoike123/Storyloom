{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Film Production Skill Request",
  "type": "object",
  "required": ["contract_version", "request_id", "project", "payload"],
  "properties": {
    "contract_version": {
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "locale": {
          "type": "string",
          "default": "zh-CN"
        },
        "format": {
          "type": "string"
        },
        "aspect_ratio": {
          "type": "string"
        },
        "visual_medium": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "payload": {
      "type": "object"
    },
    "options": {
      "type": "object",
      "default": {}
    },
    "resume": {
      "type": "object",
      "properties": {
        "checkpoint_id": {
          "type": "string"
        },
        "retry_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  }
}
