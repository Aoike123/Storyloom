{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifact Lineage",
  "type": "object",
  "required": ["inputs", "source_refs"],
  "properties": {
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_type", "artifact_id"],
        "properties": {
          "artifact_type": {
            "type": "string"
          },
          "artifact_id": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checksum": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id"],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "range": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
