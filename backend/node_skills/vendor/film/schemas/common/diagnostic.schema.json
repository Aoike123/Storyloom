{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Diagnostic",
  "type": "object",
  "required": ["code", "severity", "message"],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "severity": {
      "enum": ["info", "warning", "error"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string"
    },
    "related_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
